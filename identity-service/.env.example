# SQL Server (xác thực Windows)
DB_NAME=auth_db
DB_HOST=.\MSSQLSERVER01
DB_DRIVER=ODBC Driver 17 for SQL Server

SECRET_KEY=doi-thanh-chuoi-bi-mat-rieng
DEBUG=True

# Khóa ký JWT (tạo bằng: python manage.py generate_jwt_keys)
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# Thời hạn token
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_HOURS=24

# Khóa tạm tài khoản khi đăng nhập sai nhiều lần
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Triển khai thật: DEBUG=False, SECRET_KEY riêng dài tối thiểu 50 ký tự và khai báo đúng tên miền.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Các tùy chọn dưới mặc định là True khi DEBUG=False. Chỉ tắt khi chạy HTTP trên máy local.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# TRUST_PROXY_HEADERS=True
