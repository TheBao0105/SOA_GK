# SQL Server (Windows Authentication). Bỏ trống thì dùng giá trị mặc định trong settings.py
DB_NAME=registration_db
DB_HOST=.\MSSQLSERVER01
DB_DRIVER=ODBC Driver 17 for SQL Server

SECRET_KEY=doi-thanh-chuoi-bi-mat-rieng
DEBUG=True

# URL của các service khác (giao tiếp qua HTTP/REST)
STUDENT_SERVICE_URL=http://127.0.0.1:8001
THESIS_SERVICE_URL=http://127.0.0.1:8002

# Khóa CÔNG KHAI của Identity Service để xác minh JWT
JWT_PUBLIC_KEY_PATH=../identity-service/keys/jwt_public.pem

# Token kỹ thuật (role SERVICE) cho lệnh seed_data gọi sang Student/Thesis.
# Tạo bằng: cd identity-service && python manage.py issue_service_token registration-service
SERVICE_TOKEN=

# Triển khai thật: DEBUG=False, SECRET_KEY riêng dài tối thiểu 50 ký tự và khai báo đúng tên miền.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Các tùy chọn dưới mặc định là True khi DEBUG=False. Chỉ tắt khi chạy HTTP trên máy local.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# TRUST_PROXY_HEADERS=True

# Mặc định True khi triển khai thật, False khi phát triển local. Identity tắt thì từ chối request (an toàn).
# JWT_CHECK_ACCOUNT_STATE=True

# Demo SOA local: False = xác minh JWT tại chỗ (offline); True = hỏi Identity trạng thái tài khoản mỗi request (online).
# run_demo.bat offline/online đặt cùng một chế độ cho cả ba service mà không cần sửa .env.
# Khi chạy bằng run_all.bat: DEBUG=True thì mặc định False; DEBUG=False thì mặc định True.
