# SQL Server (Windows Authentication). Bỏ trống thì dùng giá trị mặc định trong settings.py
DB_NAME=thesis_db
DB_HOST=.\MSSQLSERVER01
DB_DRIVER=ODBC Driver 17 for SQL Server

# Bảo mật: đặt giá trị riêng khi triển khai thật
SECRET_KEY=doi-thanh-chuoi-bi-mat-rieng
DEBUG=True

# Khóa CÔNG KHAI của Identity Service để xác minh JWT (không cần khóa bí mật)
JWT_PUBLIC_KEY_PATH=../identity-service/keys/jwt_public.pem

# Registration Service: kiểm tra đăng ký còn hiệu lực trước khi xóa
REGISTRATION_SERVICE_URL=http://127.0.0.1:8003

# Production: DEBUG=False, unique SECRET_KEY >= 50 characters and exact hosts.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Defaults become True when DEBUG=False. Only disable for local HTTP development.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# TRUST_PROXY_HEADERS=True

# Defaults True in production, False during local development. Fail closed if Identity is down.
# JWT_CHECK_ACCOUNT_STATE=True

# Local SOA demo: False = offline JWT validation; True = immediate account checks via Identity.
# run_demo.bat offline/online sets the same mode for all three services without editing .env.
# In run_all.bat mode, DEBUG=True defaults to False; DEBUG=False defaults to True.
